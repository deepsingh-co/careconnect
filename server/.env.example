# CareConnect Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to source control

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ─── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/careconnect
# Production example:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/careconnect

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ─── WhatsApp Integration ─────────────────────────────────────────────────────
# Set WHATSAPP_PROVIDER to "meta" or "twilio". Leave blank for DEMO MODE.
WHATSAPP_PROVIDER=

# Meta (Facebook) WhatsApp Cloud API
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_with_random_string
META_WHATSAPP_APP_SECRET=
# OTP delivery uses a pre-approved Meta AUTHENTICATION template (see WHATSAPP_SETUP.md)
META_WHATSAPP_OTP_TEMPLATE=otp_verification
META_WHATSAPP_OTP_TEMPLATE_LANG=en_US
# Set to true if your template has a "Copy code" button
META_WHATSAPP_OTP_TEMPLATE_BUTTON=false

# Twilio WhatsApp API
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
# Set AI_PROVIDER to "openai" or "google". Leave blank for deterministic fallback.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-1.5-flash

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@careconnect.health

# ─── Maps / Geocoding ─────────────────────────────────────────────────────────
MAPS_PROVIDER=
GOOGLE_MAPS_API_KEY=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
